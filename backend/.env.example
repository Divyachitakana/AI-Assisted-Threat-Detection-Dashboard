# Copy to .env and adjust as needed. All values have sensible dev defaults
# in app/config.py, so .env is optional for local development.

ENV=development
DATABASE_URL=sqlite:///./threat_dashboard.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTO_SEED=true

